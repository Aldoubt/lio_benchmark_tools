#!/usr/bin/env python3
"""LIO benchmark run-directory orchestrator."""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

MODULE_ROOT = Path(__file__).resolve().parents[2]
if str(MODULE_ROOT) not in sys.path:
    sys.path.insert(0, str(MODULE_ROOT))

from benchmark_base.lib.manifest import load_json, resolve_manifest, validate_manifest  # noqa: E402
from benchmark_base.lib.registry import Registry, RegistryError  # noqa: E402


BASE_RUN_DIRS = (
    "input",
    "configs",
    "standardized/trajectories",
    "standardized/maps",
    "metrics",
    "figures",
    "reports",
    "logs",
    "metadata",
)
REGISTRY = Registry()


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).astimezone().isoformat()


def resolved_runner(config: dict[str, Any]) -> Path:
    if isinstance(config.get("runner"), dict):
        value = config["runner"]["adapter"]
    else:
        value = config.get("runner", "")
    path = Path(str(value))
    return path if path.is_absolute() else MODULE_ROOT / path


def resolved_source_hint(config: dict[str, Any]) -> str:
    source = config.get("source", "")
    if isinstance(source, dict):
        return str(source.get("local_path_hint", ""))
    return str(source)


def resolve_config(path: Path, verify_hash: bool = False) -> tuple[dict[str, Any], dict[str, Any]]:
    manifest = load_json(path)
    errors = validate_manifest(
        manifest,
        registry=REGISTRY,
        verify_hash=verify_hash,
        module_root=MODULE_ROOT,
    )
    if errors:
        raise SystemExit("manifest validation failed:\n- " + "\n- ".join(errors))
    try:
        resolved = resolve_manifest(manifest, REGISTRY)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc
    return manifest, resolved


def resolve_run(path: Path) -> tuple[Path, dict[str, Any]]:
    run = path.resolve()
    manifest_path = run / "manifest.json"
    if not manifest_path.is_file():
        raise SystemExit(f"not a standard run directory; missing {manifest_path}")
    try:
        return run, load_json(manifest_path)
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc


def run_command(command: list[str], cwd: Path, output: Path | None = None) -> None:
    if output:
        output.parent.mkdir(parents=True, exist_ok=True)
        with output.open("w", encoding="utf-8") as stream:
            result = subprocess.run(command, cwd=cwd, stdout=stream, stderr=subprocess.STDOUT, text=True, check=False)
    else:
        result = subprocess.run(command, cwd=cwd, check=False)
    if result.returncode:
        raise SystemExit(f"command failed ({result.returncode}): {' '.join(command)}")


def cmd_validate(args: argparse.Namespace) -> None:
    source, resolved = resolve_config(args.config.resolve(), args.verify_hash)
    print("validation passed")
    print(f"schema_version={source['schema_version']}")
    print(f"experiment={source['name']}")
    dataset = resolved["dataset"]
    print(f"dataset={dataset.get('dataset_id', dataset.get('bag_dir'))}")
    print(f"bag={dataset['bag_dir']}")
    print(f"algorithms={','.join(resolved['algorithms'])}")


def cmd_init(args: argparse.Namespace) -> None:
    config = args.config.resolve()
    source, resolved = resolve_config(config)
    run_id = args.run_id or f"{source['name']}_{dt.datetime.now().strftime('%Y%m%d_%H%M%S')}"
    if not run_id.replace("-", "").replace("_", "").isalnum():
        raise SystemExit("run-id may contain only letters, numbers, underscore and hyphen")
    run = Path(source["output_root"]).expanduser() / run_id
    if run.exists():
        raise SystemExit(f"refusing to overwrite existing run: {run}")
    directories = list(BASE_RUN_DIRS) + [f"raw/{name}" for name in resolved["algorithms"]]
    for relative in directories:
        (run / relative).mkdir(parents=True, exist_ok=False)
    frozen = dict(resolved)
    frozen["run_id"] = run_id
    frozen["created_at"] = now_iso()
    frozen["source_manifest"] = str(config)
    frozen["source_manifest_schema_version"] = source["schema_version"]
    (run / "manifest.json").write_text(json.dumps(frozen, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    dataset = frozen["dataset"]
    (run / "input" / "DATASET.txt").write_text(
        f"dataset_id={dataset.get('dataset_id', '')}\n"
        f"bag_dir={dataset['bag_dir']}\n"
        f"sha256={dataset.get('sha256', '')}\n",
        encoding="utf-8",
    )
    (run / "RUN_STATUS.md").write_text(
        f"# Run {run_id}\n\n"
        f"- status: initialized\n"
        f"- created: {frozen['created_at']}\n"
        "- bag analysis: pending\n"
        "- frontend runs: pending\n"
        "- standardization: pending\n"
        "- report: pending\n",
        encoding="utf-8",
    )
    print(run)


def cmd_analyze_bag(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    workspace = Path(manifest["workspace"]).expanduser()
    analyzer = MODULE_ROOT / "evaluators/analyze_bag.py"
    output = run / "metrics/bag_analysis.json"
    run_command(
        [sys.executable, str(analyzer), manifest["dataset"]["bag_dir"], "--output", str(output)],
        workspace,
        run / "logs/analyze_bag.log",
    )
    print(output)


def git_state(path: Path) -> dict[str, Any]:
    if not (path / ".git").exists():
        return {"path": str(path), "git": False}

    def capture(*parts: str) -> str:
        return subprocess.run(
            ["git", "-C", str(path), *parts], text=True, capture_output=True, check=False
        ).stdout.strip()

    return {
        "path": str(path),
        "git": True,
        "commit": capture("rev-parse", "HEAD"),
        "branch": capture("rev-parse", "--abbrev-ref", "HEAD"),
        "dirty": bool(capture("status", "--porcelain")),
    }


def cmd_snapshot(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    workspace = Path(manifest["workspace"]).expanduser()
    sources = [workspace]
    for config in manifest["algorithms"].values():
        hint = resolved_source_hint(config)
        if not hint:
            continue
        source = Path(hint).expanduser()
        if not source.is_absolute():
            source = workspace / source
        if source.is_dir() and source not in sources:
            sources.append(source)
    metadata = {
        "captured_at": now_iso(),
        "platform": platform.platform(),
        "python": platform.python_version(),
        "ros_distro": os.environ.get("ROS_DISTRO", ""),
        "git_sources": [git_state(path) for path in sources],
        "executables": {name: shutil.which(name) for name in ("ros2", "colcon", "cmake", "git", "ffmpeg")},
    }
    path = run / "metadata/environment_snapshot.json"
    path.write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(path)


def algorithm_command(run: Path, manifest: dict[str, Any], algorithm_id: str) -> list[str]:
    if algorithm_id not in manifest["algorithms"]:
        raise SystemExit(f"algorithm is not selected in this run: {algorithm_id}")
    runner = resolved_runner(manifest["algorithms"][algorithm_id])
    if not runner.is_file():
        raise SystemExit(f"runner does not exist: {runner}")
    bag = str(manifest["dataset"]["bag_dir"])
    output = str(run / "raw" / algorithm_id)
    return ["bash", str(runner), bag, output]


def execute_algorithm(run: Path, manifest: dict[str, Any], algorithm_id: str) -> int:
    command = algorithm_command(run, manifest, algorithm_id)
    log_path = run / "logs" / f"run_{algorithm_id}.log"
    status_path = run / "metadata" / f"run_{algorithm_id}.json"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    started = now_iso()
    with log_path.open("w", encoding="utf-8") as stream:
        result = subprocess.run(command, cwd=Path(manifest["workspace"]).expanduser(), stdout=stream, stderr=subprocess.STDOUT, text=True, check=False)
    status = {
        "algorithm_id": algorithm_id,
        "started_at": started,
        "finished_at": now_iso(),
        "command": command,
        "returncode": result.returncode,
        "status": "PASS" if result.returncode == 0 else "FAIL",
        "log": str(log_path),
        "raw_output": str(run / "raw" / algorithm_id),
    }
    status_path.write_text(json.dumps(status, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(f"{algorithm_id}: {status['status']} returncode={result.returncode}")
    return result.returncode


def cmd_run(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    returncode = execute_algorithm(run, manifest, args.algorithm)
    if returncode:
        raise SystemExit(returncode)


def cmd_run_all(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    failures: list[tuple[str, int]] = []
    for algorithm_id in manifest["algorithms"]:
        returncode = execute_algorithm(run, manifest, algorithm_id)
        if returncode:
            failures.append((algorithm_id, returncode))
            if args.stop_on_failure:
                break
    if failures:
        print("failed algorithms:", file=sys.stderr)
        for algorithm_id, code in failures:
            print(f"- {algorithm_id}: {code}", file=sys.stderr)
        raise SystemExit(1)


def cmd_commands(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    for name in manifest["algorithms"]:
        print(f"# {name} ({manifest['algorithms'][name]['mode']})")
        print(" ".join(json.dumps(part) for part in algorithm_command(run, manifest, name)))


def cmd_list_registry(args: argparse.Namespace) -> None:
    values = REGISTRY.list_algorithms() if args.kind == "algorithms" else REGISTRY.list_datasets()
    for item in values:
        print(item)


def cmd_show_registry(args: argparse.Namespace) -> None:
    try:
        record = REGISTRY.load_algorithm(args.id) if args.kind == "algorithm" else REGISTRY.load_dataset(args.id)
    except RegistryError as exc:
        raise SystemExit(str(exc)) from exc
    print(json.dumps(record, ensure_ascii=False, indent=2))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="lio-benchmark")
    sub = parser.add_subparsers(dest="command", required=True)

    validate = sub.add_parser("validate")
    validate.add_argument("--config", type=Path, required=True)
    validate.add_argument("--verify-hash", action="store_true")
    validate.set_defaults(func=cmd_validate)

    init = sub.add_parser("init")
    init.add_argument("--config", type=Path, required=True)
    init.add_argument("--run-id")
    init.set_defaults(func=cmd_init)

    analyze = sub.add_parser("analyze-bag")
    analyze.add_argument("--run", type=Path, required=True)
    analyze.set_defaults(func=cmd_analyze_bag)

    snapshot = sub.add_parser("snapshot")
    snapshot.add_argument("--run", type=Path, required=True)
    snapshot.set_defaults(func=cmd_snapshot)

    run = sub.add_parser("run")
    run.add_argument("--run", type=Path, required=True)
    run.add_argument("--algorithm", required=True)
    run.set_defaults(func=cmd_run)

    run_all = sub.add_parser("run-all")
    run_all.add_argument("--run", type=Path, required=True)
    run_all.add_argument("--stop-on-failure", action="store_true")
    run_all.set_defaults(func=cmd_run_all)

    commands = sub.add_parser("commands")
    commands.add_argument("--run", type=Path, required=True)
    commands.set_defaults(func=cmd_commands)

    listing = sub.add_parser("list")
    listing.add_argument("kind", choices=("algorithms", "datasets"))
    listing.set_defaults(func=cmd_list_registry)

    show = sub.add_parser("show")
    show.add_argument("kind", choices=("algorithm", "dataset"))
    show.add_argument("id")
    show.set_defaults(func=cmd_show_registry)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
