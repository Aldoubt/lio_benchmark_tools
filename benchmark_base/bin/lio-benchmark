#!/usr/bin/env python3
"""LIO Benchmark Tools command dispatcher.

The established V2 CLI remains available in ``lio-benchmark-core``. This
dispatcher preserves its importable parser contract while adding focused new
commands incrementally.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys

MODULE_ROOT = Path(__file__).resolve().parents[2]
CORE = Path(__file__).with_name("lio-benchmark-core")


def _load_core():
    loader = importlib.machinery.SourceFileLoader("lio_benchmark_core", str(CORE))
    spec = importlib.util.spec_from_loader("lio_benchmark_core", loader)
    if spec is None:
        raise RuntimeError(f"unable to load CLI core: {CORE}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


_core = _load_core()

from benchmark_base.lib.suite_events import observe_execution  # noqa: E402
from benchmark_base.lib.suite_orchestrator import execute_suite  # noqa: E402
from benchmark_base.lib.suite_plan import (  # noqa: E402
    build_suite_plan,
    load_and_validate_suite_plan,
    write_suite_plan,
)
from benchmark_base.lib.suite_status import derive_suite_status, status_to_dict  # noqa: E402


_SHA256_RE = re.compile(r"^[0-9a-fA-F]{64}$")


def _initialize_run(config: Path, run_id: str | None = None) -> Path:
    """Reuse the historical core init semantics while returning the run path."""
    config = config.resolve()
    source, resolved = _core.resolve_config(config)
    resolved_run_id = run_id or (
        f"{source['name']}_{_core.dt.datetime.now().strftime('%Y%m%d_%H%M%S')}"
    )
    if not resolved_run_id.replace("-", "").replace("_", "").isalnum():
        raise SystemExit("run-id may contain only letters, numbers, underscore and hyphen")
    run = Path(source["output_root"]).expanduser() / resolved_run_id
    if run.exists():
        raise SystemExit(f"refusing to overwrite existing run: {run}")
    for relative in list(_core.BASE_RUN_DIRS) + [
        f"raw/{name}" for name in resolved["algorithms"]
    ]:
        (run / relative).mkdir(parents=True, exist_ok=False)
    frozen = dict(resolved)
    frozen.update(
        run_id=resolved_run_id,
        created_at=_core.now_iso(),
        source_manifest=str(config),
        source_manifest_schema_version=source["schema_version"],
    )
    (run / "manifest.json").write_text(
        json.dumps(frozen, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    dataset = frozen["dataset"]
    (run / "input" / "DATASET.txt").write_text(
        f"dataset_id={dataset.get('dataset_id', '')}\n"
        f"bag_dir={dataset['bag_dir']}\n"
        f"sha256={dataset.get('sha256', '')}\n",
        encoding="utf-8",
    )
    (run / "RUN_STATUS.md").write_text(
        f"# Run {resolved_run_id}\n\n- status: initialized\n- created: {frozen['created_at']}\n"
        "- bag analysis: pending\n- frontend runs: pending\n"
        "- standardization: pending\n- report: pending\n",
        encoding="utf-8",
    )
    return run


def _cmd_init(args: argparse.Namespace) -> None:
    print(_initialize_run(args.config.resolve(), args.run_id))


# The public dispatcher is the supported entry point. Install the reusable helper
# into the loaded historical core module so its parser retains the exact init CLI
# surface while suite orchestration can use the same initialization implementation.
_core.initialize_run = _initialize_run
_core.cmd_init = _cmd_init


def cmd_audit_trajectory_coverage(args: argparse.Namespace) -> int:
    run, manifest = _core.resolve_run(args.run)
    arguments = ["--run", str(run)]
    if args.algorithms:
        arguments.extend(["--algorithms", *args.algorithms])
    _core.run_python_ros(
        run,
        manifest,
        "evaluators/audit_trajectory_coverage.py",
        arguments,
    )
    return 0


def cmd_audit_trajectory_timestamps(args: argparse.Namespace) -> int:
    run, manifest = _core.resolve_run(args.run)
    arguments = ["--run", str(run), "--algorithms", *args.algorithms]
    _core.run_python_ros(
        run,
        manifest,
        "evaluators/audit_trajectory_timestamps.py",
        arguments,
    )
    return 0


def cmd_audit_failure_mode(args: argparse.Namespace) -> int:
    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/audit_failure_modes.py"),
        "--run-root",
        str(args.run_root),
        "--batch-id",
        str(args.batch_id),
    ]
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def cmd_dataset_probe(args: argparse.Namespace) -> int:
    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/probe_dataset.py"),
        "--bag",
        str(args.bag),
    ]
    if args.output is not None:
        command.extend(["--output", str(args.output)])
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def cmd_dataset_freeze(args: argparse.Namespace) -> int:
    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/freeze_dataset.py"),
        "--probe",
        str(args.probe),
        "--dataset-id",
        str(args.dataset_id),
        "--lidar-topic",
        str(args.lidar_topic),
        "--imu-topic",
        str(args.imu_topic),
        "--profile",
        str(args.profile),
        "--imu-angular-velocity-unit",
        str(args.imu_angular_velocity_unit),
        "--imu-linear-acceleration-unit",
        str(args.imu_linear_acceleration_unit),
        "--output",
        str(args.output),
    ]
    if args.rotation_lidar_to_imu is not None:
        command.extend(
            ["--rotation-lidar-to-imu", *(str(value) for value in args.rotation_lidar_to_imu)]
        )
    if args.translation_lidar_to_imu is not None:
        command.extend(
            ["--translation-lidar-to-imu", *(str(value) for value in args.translation_lidar_to_imu)]
        )
    if args.calibration_source is not None:
        command.extend(["--calibration-source", str(args.calibration_source)])
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def cmd_summarize_same_bag(args: argparse.Namespace) -> int:
    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/summarize_same_bag.py"),
        "--run",
        str(args.run),
    ]
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def cmd_finalize_same_bag(args: argparse.Namespace) -> int:
    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/finalize_same_bag.py"),
        "--run",
        str(args.run),
    ]
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def cmd_standardize_common_map_manifest(args: argparse.Namespace) -> None:
    run, manifest = _core.resolve_run(args.run)
    _core.run_python_ros(
        run,
        manifest,
        "evaluators/build_common_map_manifest.py",
        ["--run", str(run)],
    )


def cmd_plan_representative_windows(args: argparse.Namespace) -> int:
    run, manifest = _core.resolve_run(args.run)
    _core.run_python_ros(
        run,
        manifest,
        "evaluators/plan_representative_windows.py",
        ["--run", str(run)],
    )
    return 0


def _require_suite_dataset_identity(resolved: dict) -> None:
    dataset = resolved.get("dataset")
    sha = dataset.get("sha256") if isinstance(dataset, dict) else None
    if not isinstance(sha, str) or not _SHA256_RE.fullmatch(sha):
        raise SystemExit(
            "suite run requires resolved dataset.sha256 as a frozen 64-hex content identity"
        )


def cmd_suite_run(args: argparse.Namespace) -> int:
    config = args.config.resolve()
    _, resolved = _core.resolve_config(config)
    _require_suite_dataset_identity(resolved)
    run = _core.initialize_run(config, args.run_id)
    try:
        frozen = _core.load_json(run / "manifest.json")
        plan = build_suite_plan(run, frozen)
        write_suite_plan(run, plan)
    except Exception as exc:
        raise SystemExit(
            f"suite plan creation failed after run initialization: {run}; "
            f"do not adopt or repair this run; use a new run-id: {exc}"
        ) from exc
    result = execute_suite(run, cli_path=Path(__file__).resolve())
    print(run)
    print(f"suite_state={result.state}")
    return int(result.exit_code)


def cmd_suite_status(args: argparse.Namespace) -> int:
    run = args.run.resolve()
    execution = observe_execution(run)
    status = derive_suite_status(run, execution=execution)
    if args.json:
        print(json.dumps(status_to_dict(status), ensure_ascii=False, indent=2))
        return 0
    print("Benchmark Suite")
    print(f"Run     : {status.run}")
    print(f"Profile : {status.profile}")
    print(f"Dataset : {status.dataset_id}")
    print()
    width = max((len(stage.stage_id) for stage in status.stages), default=5)
    for stage in status.stages:
        reason = f" [{stage.reason_code}]" if stage.reason_code else ""
        print(f"{stage.stage_id:<{width}}  {stage.state}{reason}")
    print()
    print(f"SUITE{' ' * max(1, width - 5)}  {status.state}")
    return 0


def cmd_suite_resume(args: argparse.Namespace) -> int:
    run = args.run.resolve()
    load_and_validate_suite_plan(run)
    result = execute_suite(run, cli_path=Path(__file__).resolve())
    print(run)
    print(f"suite_state={result.state}")
    return int(result.exit_code)


def _subparser_action(parser: argparse.ArgumentParser, dest: str):
    for action in parser._actions:  # argparse exposes no public lookup API
        if isinstance(action, argparse._SubParsersAction) and action.dest == dest:
            return action
    raise RuntimeError(f"unable to find subparser destination: {dest}")


def build_parser() -> argparse.ArgumentParser:
    """Return the historical parser plus focused additive commands."""
    parser = _core.build_parser()
    root_sub = _subparser_action(parser, "command")

    audit_parser = root_sub.choices["audit"]
    audit_sub = _subparser_action(audit_parser, "audit_command")
    coverage = audit_sub.add_parser(
        "trajectory-coverage",
        help="describe LiDAR input, adapter, and trajectory cadence coverage",
    )
    coverage.add_argument("--run", type=Path, required=True)
    coverage.add_argument("--algorithms", nargs="+")
    coverage.set_defaults(func=cmd_audit_trajectory_coverage)

    timestamps = audit_sub.add_parser(
        "trajectory-timestamps",
        help="diagnose raw trajectory header, bag-record, and effective timestamp ordering",
    )
    timestamps.add_argument("--run", type=Path, required=True)
    timestamps.add_argument("--algorithms", nargs="+", required=True)
    timestamps.set_defaults(func=cmd_audit_trajectory_timestamps)

    failure_mode = audit_sub.add_parser(
        "failure-mode",
        help="relate existing trajectory coverage degradation to Relative SE(3) onsets",
    )
    failure_mode.add_argument("--run-root", type=Path, required=True)
    failure_mode.add_argument("--batch-id", required=True)
    failure_mode.set_defaults(func=cmd_audit_failure_mode)

    standardize_parser = root_sub.choices["standardize"]
    standardize_sub = _subparser_action(standardize_parser, "standardize_command")
    common_map = standardize_sub.add_parser(
        "common-map-manifest",
        help="freeze the strict all-algorithm matched LiDAR scan intersection",
    )
    common_map.add_argument("--run", type=Path, required=True)
    common_map.set_defaults(func=cmd_standardize_common_map_manifest)

    dataset_parser = root_sub.add_parser(
        "dataset",
        help="inspect and freeze external dataset contracts without running estimators",
    )
    dataset_sub = dataset_parser.add_subparsers(dest="dataset_command", required=True)

    probe = dataset_sub.add_parser(
        "probe",
        help="write read-only ROS 2 bag evidence for later explicit dataset freezing",
    )
    probe.add_argument("--bag", type=Path, required=True)
    probe.add_argument("--output", type=Path)
    probe.set_defaults(func=cmd_dataset_probe)

    freeze = dataset_sub.add_parser(
        "freeze",
        help="freeze an immutable dataset.json + inspection.json from probe evidence",
    )
    freeze.add_argument("--probe", type=Path, required=True)
    freeze.add_argument("--dataset-id", required=True)
    freeze.add_argument("--lidar-topic", required=True)
    freeze.add_argument("--imu-topic", required=True)
    freeze.add_argument(
        "--profile",
        required=True,
        choices=("mid360-internal", "mid360-user-extrinsic", "unknown-lidar-imu"),
    )
    freeze.add_argument(
        "--imu-angular-velocity-unit",
        required=True,
        choices=("rad_s", "unknown"),
    )
    freeze.add_argument(
        "--imu-linear-acceleration-unit",
        required=True,
        choices=("m_s2", "g_like_raw", "unknown"),
    )
    freeze.add_argument("--output", type=Path, required=True)
    freeze.add_argument("--rotation-lidar-to-imu", nargs=9, type=float)
    freeze.add_argument("--translation-lidar-to-imu", nargs=3, type=float)
    freeze.add_argument("--calibration-source")
    freeze.set_defaults(func=cmd_dataset_freeze)

    plan_parser = root_sub.add_parser(
        "plan",
        help="derive immutable experiment plans from frozen run evidence",
    )
    plan_sub = plan_parser.add_subparsers(dest="plan_command", required=True)
    representative = plan_sub.add_parser(
        "representative-windows",
        help="select fixed raw-sensor representative windows from a full-bag selector run",
    )
    representative.add_argument("--run", type=Path, required=True)
    representative.set_defaults(func=cmd_plan_representative_windows)

    summarize_parser = root_sub.add_parser(
        "summarize",
        help="summarize already-frozen benchmark artifacts without rerunning algorithms",
    )
    summarize_sub = summarize_parser.add_subparsers(dest="summarize_command", required=True)
    same_bag = summarize_sub.add_parser(
        "same-bag",
        help="write Same-Bag Mapping Benchmark V1 I/O, map, and runtime summaries",
    )
    same_bag.add_argument("--run", type=Path, required=True)
    same_bag.set_defaults(func=cmd_summarize_same_bag)

    same_bag_finalize = summarize_sub.add_parser(
        "same-bag-finalize",
        help="append a final Same-Bag V1 package when an earlier immutable summary was premature",
    )
    same_bag_finalize.add_argument("--run", type=Path, required=True)
    same_bag_finalize.set_defaults(func=cmd_finalize_same_bag)

    suite_parser = root_sub.add_parser(
        "suite",
        help="run, inspect, and resume the immutable Same-Bag Mapping V1 orchestration",
    )
    suite_sub = suite_parser.add_subparsers(dest="suite_command", required=True)

    suite_run = suite_sub.add_parser(
        "run",
        help="create a new suite-managed run and execute safe stages sequentially",
    )
    suite_run.add_argument("--config", type=Path, required=True)
    suite_run.add_argument("--run-id", required=True)
    suite_run.set_defaults(func=cmd_suite_run)

    suite_status = suite_sub.add_parser(
        "status",
        help="derive suite state from immutable artifacts without mutation",
    )
    suite_status.add_argument("--run", type=Path, required=True)
    suite_status.add_argument("--json", action="store_true")
    suite_status.set_defaults(func=cmd_suite_status)

    suite_resume = suite_sub.add_parser(
        "resume",
        help="resume only missing stages that are still safe to execute",
    )
    suite_resume.add_argument("--run", type=Path, required=True)
    suite_resume.set_defaults(func=cmd_suite_resume)
    return parser


def _compare(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="lio-benchmark compare")
    sub = parser.add_subparsers(dest="compare_command", required=True)

    relative_se3 = sub.add_parser(
        "relative-se3",
        help="compare provenance-gated relative SE(3) motion disagreement",
    )
    relative_se3.add_argument("--run", type=Path, required=True)
    relative_se3.add_argument("--algorithms", nargs="+")
    args = parser.parse_args(argv)

    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/compare_relative_se3.py"),
        "--run",
        str(args.run),
    ]
    if args.algorithms:
        command.extend(["--algorithms", *args.algorithms])
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def _combined_help() -> int:
    parser = build_parser()
    parser.print_help()
    print("\nAdditional comparison command:\n  compare relative-se3")
    return 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "compare":
        return _compare(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] in {"-h", "--help"}:
        return _combined_help()
    if len(sys.argv) > 2 and sys.argv[1:3] == ["audit", "trajectory-coverage"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["audit", "trajectory-timestamps"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["audit", "failure-mode"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["standardize", "common-map-manifest"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["dataset", "probe"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["dataset", "freeze"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["plan", "representative-windows"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["summarize", "same-bag"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and sys.argv[1:3] == ["summarize", "same-bag-finalize"]:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    if len(sys.argv) > 2 and tuple(sys.argv[1:3]) in {
        ("suite", "run"),
        ("suite", "status"),
        ("suite", "resume"),
    }:
        args = build_parser().parse_args(sys.argv[1:])
        return int(args.func(args) or 0)
    return _core.main()


if __name__ == "__main__":
    raise SystemExit(main())
