#!/usr/bin/env python3
"""LIO Benchmark Tools command dispatcher.

The existing V2 CLI remains byte-for-byte available in ``lio-benchmark-core``.
This dispatcher adds new comparison commands without changing established
command behavior while the CLI is incrementally modularized.
"""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys

MODULE_ROOT = Path(__file__).resolve().parents[2]
CORE = Path(__file__).with_name("lio-benchmark-core")


def _compare(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="lio-benchmark compare")
    sub = parser.add_subparsers(dest="compare_command", required=True)

    relative_se3 = sub.add_parser(
        "relative-se3",
        help="compare provenance-gated relative SE(3) motion disagreement",
    )
    relative_se3.add_argument("--run", type=Path, required=True)
    relative_se3.add_argument("--algorithms", nargs="+")
    args = parser.parse_args(argv)

    command = [
        sys.executable,
        str(MODULE_ROOT / "evaluators/compare_relative_se3.py"),
        "--run",
        str(args.run),
    ]
    if args.algorithms:
        command.extend(["--algorithms", *args.algorithms])
    return subprocess.run(command, cwd=MODULE_ROOT, check=False).returncode


def _combined_help() -> int:
    result = subprocess.run(
        [sys.executable, str(CORE), "--help"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.stdout:
        print(result.stdout.rstrip())
    if result.stderr:
        print(result.stderr.rstrip(), file=sys.stderr)
    print("\nAdditional comparison command:\n  compare relative-se3")
    return result.returncode


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "compare":
        return _compare(sys.argv[2:])
    if len(sys.argv) > 1 and sys.argv[1] in {"-h", "--help"}:
        return _combined_help()
    os.execv(sys.executable, [sys.executable, str(CORE), *sys.argv[1:]])
    raise AssertionError("os.execv returned unexpectedly")


if __name__ == "__main__":
    raise SystemExit(main())
