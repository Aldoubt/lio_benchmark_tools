#!/usr/bin/env python3
"""LIO benchmark run-directory orchestrator (standard library only)."""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


REQUIRED_DATASET_KEYS = (
    "bag_dir", "db3", "lidar_topic", "lidar_type", "imu_topic", "imu_type",
    "imu_acceleration_unit", "point_time_field", "point_time_unit",
)
RUN_DIRS = (
    "input", "configs", "raw/fast_livo2", "raw/point_lio", "raw/glim_odometry",
    "raw/glim_full_slam", "raw/dlio", "standardized/trajectories", "standardized/maps",
    "metrics", "figures", "reports", "logs", "metadata",
)
MODULE_ROOT = Path(__file__).resolve().parents[2]


def load_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SystemExit(f"配置不存在: {path}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"JSON 格式错误: {path}:{exc.lineno}:{exc.colno}: {exc.msg}") from exc
    if not isinstance(value, dict):
        raise SystemExit("实验清单顶层必须是对象")
    return value


def validate_manifest(manifest: dict[str, Any], verify_hash: bool = False) -> list[str]:
    errors: list[str] = []
    if manifest.get("schema_version") != 1:
        errors.append("schema_version 必须为 1")
    for key in ("name", "workspace", "output_root", "dataset", "calibration", "evaluation", "algorithms"):
        if key not in manifest:
            errors.append(f"缺少顶层字段: {key}")
    dataset = manifest.get("dataset", {})
    if not isinstance(dataset, dict):
        errors.append("dataset 必须是对象")
        return errors
    for key in REQUIRED_DATASET_KEYS:
        if key not in dataset or dataset[key] in (None, ""):
            errors.append(f"dataset 缺少字段: {key}")
    bag_dir = Path(str(dataset.get("bag_dir", "")))
    db3 = Path(str(dataset.get("db3", "")))
    if not bag_dir.is_dir():
        errors.append(f"bag_dir 不存在: {bag_dir}")
    elif not (bag_dir / "metadata.yaml").is_file():
        errors.append(f"bag_dir 缺少 metadata.yaml: {bag_dir}")
    if not db3.is_file():
        errors.append(f"db3 不存在: {db3}")
    workspace = Path(str(manifest.get("workspace", "")))
    if not workspace.is_dir():
        errors.append(f"workspace 不存在: {workspace}")
    algorithms = manifest.get("algorithms", {})
    if not isinstance(algorithms, dict):
        errors.append("algorithms 必须是对象")
    else:
        for name, config in algorithms.items():
            if not isinstance(config, dict):
                errors.append(f"algorithm {name} 必须是对象")
                continue
            runner = Path(str(config.get("runner", "")))
            if not runner.is_absolute():
                runner = MODULE_ROOT / runner
            if not runner.is_file():
                errors.append(f"algorithm {name} runner 不存在: {runner}")
            if config.get("mode") not in ("odometry", "full_slam"):
                errors.append(f"algorithm {name} mode 必须是 odometry 或 full_slam")
    rotation = manifest.get("calibration", {}).get("rotation_lidar_to_imu_row_major", [])
    translation = manifest.get("calibration", {}).get("translation_lidar_to_imu_m", [])
    if len(rotation) != 9 or len(translation) != 3:
        errors.append("外参旋转必须 9 项、平移必须 3 项")
    if verify_hash and db3.is_file() and dataset.get("sha256"):
        digest = sha256_file(db3)
        if digest.lower() != str(dataset["sha256"]).lower():
            errors.append(f"db3 SHA-256 不匹配: actual={digest}")
    return errors


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def resolve_run(path: Path) -> tuple[Path, dict[str, Any]]:
    run = path.resolve()
    manifest_path = run / "manifest.json"
    if not manifest_path.is_file():
        raise SystemExit(f"不是标准 run 目录，缺少 {manifest_path}")
    return run, load_json(manifest_path)


def run_command(command: list[str], cwd: Path, output: Path | None = None) -> None:
    output.parent.mkdir(parents=True, exist_ok=True) if output else None
    if output:
        with output.open("w", encoding="utf-8") as stream:
            result = subprocess.run(command, cwd=cwd, stdout=stream, stderr=subprocess.STDOUT, text=True, check=False)
    else:
        result = subprocess.run(command, cwd=cwd, check=False)
    if result.returncode:
        raise SystemExit(f"命令失败 ({result.returncode}): {' '.join(command)}")


def cmd_validate(args: argparse.Namespace) -> None:
    manifest = load_json(args.config.resolve())
    errors = validate_manifest(manifest, args.verify_hash)
    if errors:
        print("验证失败:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        raise SystemExit(2)
    print("验证通过")
    print(f"experiment={manifest['name']}")
    print(f"bag={manifest['dataset']['bag_dir']}")
    print(f"algorithms={','.join(manifest['algorithms'])}")


def cmd_init(args: argparse.Namespace) -> None:
    config = args.config.resolve()
    manifest = load_json(config)
    errors = validate_manifest(manifest)
    if errors:
        raise SystemExit("清单验证失败，先运行 validate:\n- " + "\n- ".join(errors))
    run_id = args.run_id or f"{manifest['name']}_{dt.datetime.now().strftime('%Y%m%d_%H%M%S')}"
    if not run_id.replace("-", "").replace("_", "").isalnum():
        raise SystemExit("run-id 只能包含字母、数字、下划线和短横线")
    run = Path(manifest["output_root"]) / run_id
    if run.exists():
        raise SystemExit(f"拒绝覆盖已有 run: {run}")
    for relative in RUN_DIRS:
        (run / relative).mkdir(parents=True, exist_ok=False)
    frozen = dict(manifest)
    frozen["run_id"] = run_id
    frozen["created_at"] = dt.datetime.now(dt.timezone.utc).astimezone().isoformat()
    frozen["source_manifest"] = str(config)
    (run / "manifest.json").write_text(json.dumps(frozen, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    (run / "input" / "DATASET.txt").write_text(
        f"bag_dir={manifest['dataset']['bag_dir']}\ndb3={manifest['dataset']['db3']}\n"
        f"sha256={manifest['dataset'].get('sha256', '')}\n", encoding="utf-8")
    (run / "RUN_STATUS.md").write_text(
        f"# Run {run_id}\n\n- 状态：initialized\n- 创建时间：{frozen['created_at']}\n"
        "- 数据检查：pending\n- 前端运行：pending\n- 标准化：pending\n- 报告：pending\n",
        encoding="utf-8",
    )
    print(run)


def cmd_analyze_bag(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    workspace = Path(manifest["workspace"])
    analyzer = MODULE_ROOT / "evaluators/analyze_bag.py"
    output = run / "metrics/bag_analysis.json"
    run_command([sys.executable, str(analyzer), manifest["dataset"]["bag_dir"], "--output", str(output)], workspace,
                run / "logs/analyze_bag.log")
    print(output)


def git_state(path: Path) -> dict[str, Any]:
    if not (path / ".git").exists():
        return {"path": str(path), "git": False}
    def capture(*parts: str) -> str:
        return subprocess.run(["git", "-C", str(path), *parts], text=True, capture_output=True, check=False).stdout.strip()
    return {"path": str(path), "git": True, "commit": capture("rev-parse", "HEAD"),
            "branch": capture("rev-parse", "--abbrev-ref", "HEAD"), "dirty": bool(capture("status", "--porcelain"))}


def cmd_snapshot(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    workspace = Path(manifest["workspace"])
    sources = [workspace]
    for config in manifest["algorithms"].values():
        source = workspace / str(config.get("source", ""))
        if source.is_dir() and source not in sources:
            sources.append(source)
    metadata = {
        "captured_at": dt.datetime.now(dt.timezone.utc).astimezone().isoformat(),
        "platform": platform.platform(), "python": platform.python_version(),
        "ros_distro": os.environ.get("ROS_DISTRO", ""), "git_sources": [git_state(path) for path in sources],
        "executables": {name: shutil.which(name) for name in ("ros2", "colcon", "cmake", "git")},
    }
    path = run / "metadata/environment_snapshot.json"
    path.write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(path)


def cmd_commands(args: argparse.Namespace) -> None:
    run, manifest = resolve_run(args.run)
    workspace = Path(manifest["workspace"])
    bag = manifest["dataset"]["bag_dir"]
    for name, config in manifest["algorithms"].items():
        runner = Path(config["runner"])
        if not runner.is_absolute():
            runner = MODULE_ROOT / runner
        output = run / "raw" / name
        print(f"# {name} ({config['mode']})")
        print(f"bash {runner} {json.dumps(bag)} {json.dumps(str(output))}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="lio-benchmark")
    sub = parser.add_subparsers(dest="command", required=True)
    validate = sub.add_parser("validate"); validate.add_argument("--config", type=Path, required=True)
    validate.add_argument("--verify-hash", action="store_true"); validate.set_defaults(func=cmd_validate)
    init = sub.add_parser("init"); init.add_argument("--config", type=Path, required=True)
    init.add_argument("--run-id"); init.set_defaults(func=cmd_init)
    analyze = sub.add_parser("analyze-bag"); analyze.add_argument("--run", type=Path, required=True); analyze.set_defaults(func=cmd_analyze_bag)
    snapshot = sub.add_parser("snapshot"); snapshot.add_argument("--run", type=Path, required=True); snapshot.set_defaults(func=cmd_snapshot)
    commands = sub.add_parser("commands"); commands.add_argument("--run", type=Path, required=True); commands.set_defaults(func=cmd_commands)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
