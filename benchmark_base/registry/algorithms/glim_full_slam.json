{
  "schema_version": 2,
  "algorithm_id": "glim_full_slam",
  "display_name": "GLIM Full SLAM",
  "mode": "full_slam",
  "tier": "CORE",
  "family_id": "glim",
  "family": ["optimization", "direct_multi_scan", "lidar_inertial", "global_slam"],
  "evaluation_roles": ["SYSTEM_MAPPING"],
  "sensor_profile": {"lidar": true, "imu": true, "camera": false, "kinematics": false, "gnss": false, "wheel_odometry": false},
  "algorithm_generation": "glim_full_slam_baseline",
  "adapter_status": "NOT_TESTED",
  "required_modalities": ["lidar", "imu"],
  "optional_modalities": [],
  "extrinsic_convention": "IMU_TO_LIDAR",
  "source": {"repository": "koide3/glim", "branch": "master", "local_path_hint": "date/algorithms/glim"},
  "execution_implementation": {"repository": "koide3/glim", "branch": "master", "package": "glim_ros", "executable": "glim_rosnode"},
  "runner": {"adapter": "evaluators/run_glim_full_slam_test.sh"},
  "topics": {
    "inputs": {"lidar": "/livox/lidar", "imu": "/livox/imu"},
    "outputs": {
      "trajectory": "/glim_ros/odom_corrected",
      "frontend_trajectory": "/glim_ros/odom",
      "scanend_trajectory": "/glim_ros/odom_scanend_corrected",
      "frontend_lidar_trajectory": "/glim_ros/lidar_odom",
      "backend_lidar_trajectory": "/glim_ros/lidar_odom_corrected",
      "dump": "dump"
    }
  },
  "artifact_roles": {
    "frontend_trajectory": "ODOMETRY",
    "trajectory": "SYSTEM_MAPPING",
    "dump": "SYSTEM_MAPPING_DIAGNOSTIC"
  },
  "live_debug": {
    "namespace_capable": false,
    "setup": ["source /opt/ros/humble/setup.bash", "export CMAKE_PREFIX_PATH=\"$WORKSPACE/date/install/glim_deps:${CMAKE_PREFIX_PATH:-}\"", "export LD_LIBRARY_PATH=\"$WORKSPACE/date/install/glim_deps/lib:$WORKSPACE/date/install/glim_ros2/glim_ros/lib:${LD_LIBRARY_PATH:-}\"", "source \"$WORKSPACE/date/install/glim_ros2/setup.bash\""],
    "processes": [{"name": "estimator", "command": "ros2 run glim_ros glim_rosnode --ros-args -p config_path:=\"$WORKSPACE/date/glim_full_slam_test/config\" -p dump_path:=\"$SESSION_DIR/logs/glim_full_slam_dump\"", "background": false}],
    "diagnostic_topics": ["/glim_ros/odom", "/glim_ros/odom_corrected", "/glim_ros/lidar_odom_corrected"]
  },
  "benchmark_notes": "GLIM Full SLAM remains one runnable mode in family=glim. Its corrected trajectory is SYSTEM_MAPPING evidence; the uncorrected odometry remains separate ODOMETRY evidence. T_lidar_imu is IMU_TO_LIDAR per upstream documentation."
}
